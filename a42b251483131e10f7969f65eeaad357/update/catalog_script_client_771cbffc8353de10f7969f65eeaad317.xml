	var expenseDay = newValue.split('/');
	var formatedExpenseDay = new Date(expenseDay[2], expenseDay[1] - 1, expenseDay[0]);

	if (formatedExpenseDay.getTime() > currentDay.getTime()) {
		g_form.addErrorMessage('Não é possível selecionar datas futuras.');
		g_form.setValue('expense_date', '');
	}

